<%-include('../cabecalho.ejs')%>
<h1>Editar Turma</h1>
<div>
<a href="/turma/lst">Listar</a>
</div>
<div>
    <form  method="post">
       
        <input type="hidden" name="id" 
        value="<%=Turma.id%>"><br>
        <label>Semestre de entrada:</label>
        <input type="text" name="semestreEntrada" 
        value="<%=Turma.semestreEntrada%>"><br>
         <label>Curso:</label>
        <input type="text" name="curso"
        value="<%=Turma.curso%>"
        ><br>
        <button type="submit">Cadastrar</button>
        
    </form>
</div>


<%-include('../cabecalho.ejs')%>
<h1>Editar Curta</h1>
<div>
<a href="/curta/lst">Listar</a>
</div>
<div>
    <form  method="post">
       
        <input type="hidden" name="id" 
        value="<%=Curta.id%>"><br>

        <label>Título:</label>
        <input type="text" name="titulo" 
        value="<%=Curta.titulo%>"><br>
        
        <select name="genero" id="genero" class="form-control"><br>
                <option value="">Selecione</option>
                <%Generos.forEach(function(genero){%>
                    <option value='<%=genero.id%>'
                    <%= (Curta.genero && genero.id.toString() === Curta.genero._id.toString()) ? 'selected' : '' %> >
                        <%=genero.nome%>
                    </option>
                <%})%>
        </select><br>
        
        <label>Ano de produção:</label>
        <input type="text" name="anoProducao"
        value="<%=Curta.anoProducao%>"><br>
        
        <select name="turma" id="turma" class="form-control"><br>
                <option value="">Selecione</option>
                <%Turmas.forEach(function(turma){%>
                    <option value='<%=turma.id%>'
                    <%= (Curta.turma && turma.id.toString() === Curta.turma._id.toString()) ? 'selected' : '' %> >
                        <%=turma.semestreEntrada%>
                    </option>
                <%})%>
        </select><br>
        
        <label>Sinopse:</label>
        <input type="text" name="sinopse"
        value="<%=Curta.sinopse%>"><br>

        <select name="diretor" id="diretor" class="form-control"><br>
                <option value="">Selecione</option>
                <%Diretores.forEach(function(diretor){%>
                    <option value='<%=diretor.id%>'
                    <%= (Curta.diretor && diretor.id.toString() === Curta.diretor._id.toString()) ? 'selected' : '' %> >
                        <%=diretor.nome%>
                    </option>
                <%})%>
        </select><br>

        <label>Link:</label>
        <input type="text" name="link"
        value="<%=Curta.link%>"><br>
        
        <button type="submit">Cadastrar</button>
        
    </form>
</div>

<%-include('../rodape.ejs')%>
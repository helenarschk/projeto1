<%-include('../cabecalho.ejs')%>
<h1>Editar Curta</h1>
<div>
<a href="/curta/lst">Listar</a>
</div>
<div>
    <form  method="post">
       
        <input type="hidden" name="id" 
        value="<%=Curta.id%>"><br>

        <label>Nome:</label>
        <input type="text" name="nome" 
        value="<%=Curta.nome%>"><br>
        
        <label>Ficha:</label>
        <input type="text" name="ficha"
        value="<%=Curta.ficha%>"><br>
        
        <label>Gênero:</label>
        <input type="text" name="genero"
        value="<%=Curta.genero%>"><br>
        
        <label>Ano de produção:</label>
        <input type="text" name="anoProducao"
        value="<%=Curta.anoProducao%>"><br>
        
        <label>Turma:</label>
        <input type="text" name="turma"
        value="<%=Curta.turma%>"><br>
        
        <label>Sinopse:</label>
        <input type="text" name="sinopse"
        value="<%=Curta.sinopse%>"><br>

        <label>Diretor:</label>
        <input type="text" name="diretor"
        value="<%=Curta.diretor%>"><br>

        <label>Link:</label>
        <input type="text" name="link"
        value="<%=Curta.link%>"><br>
        
        <button type="submit">Cadastrar</button>
        
    </form>
</div>

<%-include('../rodape.ejs')%>
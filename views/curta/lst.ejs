<%-include('../cabecalho.ejs')%>
    <h1>Curtas</h1>
    <div>
        <form action="
        " method="post">
        <input type="text" name="filtro"
         id="" placeholder="digite o nome">
         <button type="submit">Pesquisar</button>
    </form>
    </div>
    <a href="/curta/add">+ Curta</a>
    <table>
        <tr>
            <td>Nome</td>
            <td>Gênero</td>
            <td>Ano</td>
            <td>Turma</td>
            <td>Diretor</td>
            <td>Link</td>
            <td>Ações</td>
        </tr>
      
        <%for (const {id, titulo, ficha, genero, anoProducao, turma, sinopse, diretor, link} of Curtas) {%>
        <tr>
            <td><%=titulo%></td>
            <td><%=genero%></td>
            <td><%=anoProducao%></td>
            <td><%=turma%></td>
            <td><%=diretor%></td>
            <td><%=link%></td>
            <td><a href="/curta/edt/<%=id%>">Editar</a>
            <a href="/curta/del/<%=id%>">Excluir</a></td>
        </tr>
        <%}%>
    </table>

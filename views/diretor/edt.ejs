<%-include('../cabecalho.ejs')%>
<h1>Editar Diretor</h1>
<div>
<a href="/diretor/lst">Listar</a>
</div>
<div>
    <form  method="post" enctype="multipart/form-data">
       
        <input type="hidden" name="id" 
        value="<%=Diretor.id%>"><br>

        <label>Nome:</label>
        <input type="text" name="nome" 
        value="<%=Diretor.nome%>"><br>

        <select name="turma" id="turma" class="form-control"><br>
                <option value="">Selecione</option>
                <%Turmas.forEach(function(turma){%>
                    <option value='<%=turma.id%>'>
                        <%=turma.semestreEntrada%>
                    </option>
                    <%})%>
            <option value="<%=turma.id%>" <%= (turma.id.toString() === Diretor.turma.toString()) ? 'selected' : '' %>
            ><%=turma.semestreEntrada%></option>
        </select><br>

        <label for="foto">Foto:</label>
        <input type="file" id="foto" name="foto"
        value="<%=Diretor.foto%>"><br>

        <button type="submit">Cadastrar</button>
        
    </form>
</div>

<%-include('../rodape.ejs')%>
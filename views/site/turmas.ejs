<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Turmas - CINEIF Bagé</title>
  <link rel="stylesheet" href="/site.css">
</head>
<body>

  <div class="header-top">
    <span>📍 IFSul Campus Bagé - Mostra de Curtas</span>
    <div class="accessibility-bar">
      <button id="btn-font-increase">A+</button>
      <button id="btn-font-decrease">A-</button>
      <button id="btn-font-reset">A</button>
      <button id="btn-contrast">👁️ Contraste</button>
    </div>
  </div>

  <header class="main-header">
    <a href="/" class="logo">
      <div class="logo-badge">CINE</div>
      <div class="logo-title">IFSul Bagé</div>
    </a>
    <nav class="main-nav">
      <ul>
        <li><a href="/">Início</a></li>
        <li><a href="/curtas">Curtas</a></li>
        <li><a href="/diretores">Diretores</a></li>
        <li><a href="/turmas" class="active">Turmas</a></li>
        <li><a href="/generos">Gêneros</a></li>
        <li><a href="#" class="btn-login" id="btn-open-login">🔑 Entrar</a></li>
      </ul>
    </nav>
  </header>

  <main class="container" style="margin-top: 2rem;">
    <h1 class="section-title">🏫 Turmas do IFSul Bagé</h1>

    <div class="grid-cards">
      <% Turmas.forEach(turma => { %>
        <% const curtasDaTurma = Curtas.filter(curta => curta.turma && curta.turma._id.toString() === turma._id.toString()) %>
        <article class="card-ticket">
          <div class="card-media">
            <% if (turma.foto) { %>
              <img src="<%= turma.foto %>" alt="Foto da turma <%= turma.curso %>">
            <% } else { %>
              <div class="card-media-placeholder" aria-hidden="true">Sem imagem</div>
            <% } %>
            <span class="badge-year"><%= turma.semestreEntrada %></span>
          </div>
          <div class="card-body">
            <h2 class="card-title"><%= turma.curso %></h2>
            <p class="card-info">Semestre de entrada: <%= turma.semestreEntrada %></p>
            <div style="margin-top: 0.8rem;">
              <strong>🎬 Produções da turma:</strong>
              <% if (curtasDaTurma.length > 0) { %>
                <ul style="margin-left: 1.2rem; font-size: 0.9rem; margin-top: 0.4rem;">
                  <% curtasDaTurma.forEach(curta => { %>
                    <li><a href="/curtas"><%= curta.titulo %></a><% if (curta.diretor) { %> (Dir. <%= curta.diretor.nome %>)<% } %></li>
                  <% }) %>
                </ul>
              <% } else { %>
                <p class="card-synopsis">Nenhum curta cadastrado para esta turma.</p>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
      <% if (Turmas.length === 0) { %>
        <p class="card-synopsis">Nenhuma turma cadastrada ainda.</p>
      <% } %>
    </div>
  </main>

  <footer>
    <div class="footer-copy">&copy; 2026 IFSul Campus Bagé</div>
  </footer>

  <script src="/script.js"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gêneros Cinematográficos - CINEIF Bagé</title>
  <link rel="stylesheet" href="/site.css">
</head>
<body>

  <div class="header-top">
    <span>📍 IFSul Campus Bagé - Mostra de Curtas</span>
    <div class="accessibility-bar">
      <button id="btn-font-increase">A+</button>
      <button id="btn-font-decrease">A-</button>
      <button id="btn-font-reset">A</button>
      <button id="btn-contrast">👁️ Contraste</button>
    </div>
  </div>

  <header class="main-header">
    <a href="/" class="logo">
      <div class="logo-badge">CINE</div>
      <div class="logo-title">IFSul Bagé</div>
    </a>
    <nav class="main-nav">
      <ul>
        <li><a href="/">Início</a></li>
        <li><a href="/curtas">Curtas</a></li>
        <li><a href="/diretores">Diretores</a></li>
        <li><a href="/turmas">Turmas</a></li>
        <li><a href="/generos" class="active">Gêneros</a></li>
        <li><a href="#" class="btn-login" id="btn-open-login">🔑 Entrar</a></li>
      </ul>
    </nav>
  </header>

  <main class="container" style="margin-top: 2rem;">
    <h1 class="section-title">🏷️ Gêneros Cinematográficos</h1>

    <div class="grid-cards">
      <% Generos.forEach(genero => { %>
        <% const curtasDoGenero = Curtas.filter(curta => curta.genero && curta.genero._id.toString() === genero._id.toString()) %>
        <article class="card-ticket">
          <div class="card-body">
            <h2 class="card-title"><%= genero.nome %></h2>
            <div style="border-top: 1px dashed #CCC; padding-top: 0.8rem; margin-top: 0.5rem;">
              <strong>Curtas neste gênero:</strong>
              <% if (curtasDoGenero.length > 0) { %>
                <ul style="margin-left: 1.2rem; font-size: 0.9rem; margin-top: 0.4rem;">
                  <% curtasDoGenero.forEach(curta => { %>
                    <li><a href="/curtas"><%= curta.titulo %></a> (<%= curta.anoProducao %>)</li>
                  <% }) %>
                </ul>
              <% } else { %>
                <p class="card-synopsis">Nenhum curta cadastrado neste gênero.</p>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
      <% if (Generos.length === 0) { %>
        <p class="card-synopsis">Nenhum gênero cadastrado ainda.</p>
      <% } %>
    </div>
  </main>

  <footer>
    <div class="footer-copy">&copy; 2026 IFSul Campus Bagé</div>
  </footer>

  <script src="/script.js"></script>
</body>
</html>